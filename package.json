{
  "name": "lexmarket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "worker": "node --import tsx worker/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "preview:html": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx scripts/preview.ts",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test tests/*.test.ts"
  },
  "overrides": {"postcss":"^8.5.28"},
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.10.0",
    "next": "^15.5.12",
    "pdf-parse": "1.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^30.1.0",
    "typescript": "^5.9.0"
  }
}
