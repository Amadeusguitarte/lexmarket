# Public: project URL and publishable/anon key. Never put the service key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server and worker only
SUPABASE_SERVICE_ROLE_KEY=
# Exact verified account emails allowed to manage professional verification
ADMIN_EMAILS=
# AI is optional. Without it, cases can be organized and published manually.
OPENAI_API_KEY=
OPENAI_MODEL=
# Private network ClamAV daemon. Files stay quarantined until a scan succeeds.
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Safe beta: keep registrations in invitation mode at Supabase until legal texts are ready.
NEXT_PUBLIC_SUPPORT_EMAIL=
